# All optional. Defaults shown.
# NVIDIA_API_KEY=nvapi-...       # NVIDIA's API: the app's Nemotron model and the evaluation judge
# ANALYST_PROVIDER=nvidia        # starting model: nvidia (default with a key) or ollama (default without);
#                                # the app's sidebar switches between them
# ANALYST_THINKING=false         # nvidia only: let Nemotron reason first (much slower)
# ANALYST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # for ANALYST_PROVIDER; ollama default: gemma2:2b
# OLLAMA_HOST=http://localhost:11434
# ANALYST_NUM_CTX=8192           # context window; raise it if long reports get cut off
# ANALYST_TIMEOUT=180            # seconds per model call before the app gives up

# Evaluation (python -m evals.run_evals)
# EVAL_JUDGE=nvidia              # or: ollama
# EVAL_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# EVAL_OLLAMA_MODEL=mistral
